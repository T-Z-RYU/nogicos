{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "USC PM",
  "version": "0.1.0",
  "identifier": "edu.usc.pm",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "title": "USC PM", "width": 1100, "height": 720, "resizable": true }
    ],
    "security": { "csp": null }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["usc-pm"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "dmg", "appimage"],
    "icon": ["icons/icon.png"]
  }
}
